{
    "version": 2,
    "functions": {
        "api/[...path].ts": {
            "maxDuration": 60
        }
    },
    "crons": [
        {
            "path": "/api/cron/silent-links",
            "schedule": "0 1 * * *"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/[...path]"
        },
        {
            "src": "/s",
            "dest": "/api/[...path]"
        },
        {
            "src": "/s/(.*)",
            "dest": "/api/[...path]"
        },
        {
            "src": "/l/(.*)",
            "dest": "/api/[...path]"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}
