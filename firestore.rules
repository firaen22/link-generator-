rules_version = '2';

// This app's Firestore data is reached ONLY through the Express server in
// server.ts, which authenticates with a service account. Service-account
// (Admin) credentials bypass these rules entirely, so denying everything here
// closes the collections to the public REST API without affecting the server.
//
// Do not loosen this. A Firebase Web API key is not a credential: any rule that
// permits anonymous reads makes `links` (client names, and the `q` payload that
// resolves to the stored report) and `readers` world-readable and listable to
// anyone who knows the project id.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
