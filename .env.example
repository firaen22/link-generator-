# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# Telegram Notification Configuration
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Firebase Configuration (VITE_ prefix required for Vite client-side access)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# FIREBASE_SERVICE_ACCOUNT: the service-account JSON (whole file, on one line).
# Required — the server authenticates every Firestore call with it. The Firebase
# Web API key above is NOT a credential and no longer grants Firestore access.
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# APP_URL: The public URL of your application (e.g., https://pmd-hk.com)
APP_URL="https://yourdomain.com"

# Tracking IDs (optional)
VITE_GA_ID="G-XXXXXXXXXX"
# ContentSquare is managed via static script in index.html

# Dub.co API Key (Legacy/Alternative)
DUB_API_KEY="your_dub_api_key_here"

# PWP_API_KEYS: comma-separated API keys accepted by protected endpoints.
PWP_API_KEYS=""
# PWP_TELEGRAM_CHATS: optional advisor-to-Telegram-chat mapping configuration.
PWP_TELEGRAM_CHATS=""
# R2_ACCOUNT_ID: Cloudflare account ID for the R2 endpoint.
R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID: Cloudflare R2 access key ID.
R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY: Cloudflare R2 secret access key.
R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME: R2 bucket used for uploaded reports and images.
R2_BUCKET_NAME=""
# FIREBASE_PROJECT_ID: server-side Firebase project ID fallback for VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=""
# FIREBASE_STORAGE_BUCKET: server-side Firebase Storage bucket fallback for VITE_FIREBASE_STORAGE_BUCKET.
FIREBASE_STORAGE_BUCKET=""
# VITE_APP_URL: optional configured public application URL.
VITE_APP_URL=""
# PORT: local HTTP server port.
PORT="3000"
# VERCEL: set by Vercel in deployed serverless runtime.
VERCEL=""
# NODE_ENV: runtime environment name.
NODE_ENV=""
